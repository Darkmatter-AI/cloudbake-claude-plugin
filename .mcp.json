{
  "mcpServers": {
    "cloudbake": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/cloudbake-mcp.mjs"],
      "env": {
        "CLOUDBAKE_PLUGIN_KEY": "${user_config.api_key}",
        "CLOUDBAKE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
